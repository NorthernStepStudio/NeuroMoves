{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "module": "esnext",
    "strict": true,
    "noEmit": true,
    "jsx": "react-native",
    "baseUrl": ".",
    "forceConsistentCasingInFileNames": true
  },
  "exclude": [
    "android",
    "backend",
    "database",
    "dist",
    "docs",
    "logs",
    "node_modules",
    "test_assets",
    "vendor"
  ]
}
